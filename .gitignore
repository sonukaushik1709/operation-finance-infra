# Terraform directories
.terraform/

# Terraform state files
terraform.tfstate
terraform.tfstate.*
*.tfstate
*.tfstate.*
*.terraform.lock.hcl

# Terraform lock file (usually SHOULD be committed)
# Uncomment the next line if you really want to ignore it
# .terraform.lock.hcl

# Crash logs
crash.log
crash.*.log

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI config files
.terraformrc
terraform.rc
